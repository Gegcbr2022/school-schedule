# Caddy, а не nginx, з однієї причини: сертифікат Let's Encrypt він
# отримує й продовжує сам. Жодного certbot, жодного крона, жодної ночі,
# коли сайт ліг, бо сертифікат протермінувався.
#
# Домен береться зі змінної оточення (див. deploy/compose.yml). Поставте
# DOMAIN=:80, щоб підняти локально без HTTPS.

{$DOMAIN:localhost} {
	root * /srv
	encode zstd gzip

	# Імена зібраних файлів містять хеш: змінився вміст — змінилось ім'я.
	# Тому їх можна кешувати назавжди й ніколи не перепитувати.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# А це — точки входу, які мусять бути свіжими. Оболонка й service
	# worker вирішують, яку версію застосунку побачить людина; розклад
	# міняється серед тижня. Закешуйте їх — і оновлення не доїде.
	@fresh path /index.html / /sw.js /manifest.webmanifest /data/*
	header @fresh Cache-Control "no-cache"

	# Дані розкладу тягне і сайт, і iOS-застосунок. Застосунок приходить
	# із власної схеми (`dzvinka://localhost`), тобто з іншого походження,
	# — без цього заголовка браузерний рушій відповідь не віддасть.
	@pack path /data/*
	header @pack Access-Control-Allow-Origin "*"

	file_server

	# Маршрутів у застосунку немає, тож це запобіжник на випадок
	# помилки в шляху, а не SPA-роутер.
	try_files {path} /index.html
}
